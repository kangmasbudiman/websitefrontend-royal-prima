---
import SiteLayout from "../layouts/SiteLayout.astro";
import HeroSlider from "../components/sections/HeroSlider";
import InfoCards from "../components/sections/InfoCards.astro";
import Tentang from "../components/sections/Tentang.astro";
import PoliklinikSection from "../components/sections/Poliklinik.astro";
import DokterSection from "../components/sections/Dokter";
import FasilitasSection from "../components/sections/Fasilitas.astro";
import AsuransiSection from "../components/sections/Asuransi.astro";
import BeritaSection from "../components/sections/Berita.astro";
import TestimoniSection from "../components/sections/Testimoni";
import { supabase } from "../lib/supabase";
import { waUrl } from "../lib/utils";
import type {
  InfoCard,
  Slider,
  Tentangkami,
  Poliklinik,
  Dokter,
  Jadwal,
  Fasilitas,
  Asuransi,
  Artikel,
  Testimoni,
  Statistik,
} from "../lib/types";

const [
  infoRes,
  sliderRes,
  tentangRes,
  poliRes,
  dokterRes,
  jadwalRes,
  fasRes,
  asurRes,
  artikelRes,
  beritaRes,
  testiRes,
  statistikRes,
] = await Promise.all([
  supabase.from("infoCard").select("*").limit(1).maybeSingle(),
  supabase.from("slider").select("*").order("id"),
  supabase.from("tentangkami").select("*").order("id"),
  supabase.from("poliklinik").select("*").order("id"),
  supabase.from("dokter").select("*, poliklinik(*)").order("id"),
  supabase.from("jadwal").select("*").order("id"),
  supabase.from("fasilitas").select("*").order("id"),
  supabase.from("asuransi").select("*").order("id"),
  supabase
    .from("artikel")
    .select("*, kategoriberita(*)")
    .order("created_at", { ascending: false })
    .limit(4),
  supabase
    .from("berita")
    .select("*, kategoriberita(*)")
    .order("created_at", { ascending: false })
    .limit(4),
  supabase.from("testimoni").select("*").order("id"),
  supabase.from("statistik").select("*").order("urutan").order("id"),
]);

const info = (infoRes.data as unknown as InfoCard | null) ?? null;
const dokter = (dokterRes.data as unknown as Dokter[]) ?? [];
const poliklinik = (poliRes.data as unknown as Poliklinik[]) ?? [];
const statistik = ((statistikRes.data as unknown as Statistik[]) ?? []).filter(
  (s) => s.status !== false
);
---

<SiteLayout info={info}>
  <HeroSlider
    client:load
    items={(sliderRes.data as unknown as Slider[]) ?? []}
    info={info}
    stats={statistik}
  />
  <InfoCards info={info} />
  <Tentang items={(tentangRes.data as unknown as Tentangkami[]) ?? []} stats={statistik} />
  <PoliklinikSection
    items={poliklinik}
    dokter={dokter}
    jadwal={(jadwalRes.data as unknown as Jadwal[]) ?? []}
    waPhone={info?.hp}
  />
  <DokterSection
    client:visible
    items={dokter}
    jadwal={(jadwalRes.data as unknown as Jadwal[]) ?? []}
    poliklinikList={poliklinik.map((p) => ({ id: p.id, nama: p.nama }))}
    waPhone={info?.hp}
  />
  <FasilitasSection
    items={(fasRes.data as unknown as Fasilitas[]) ?? []}
    waPhone={info?.hp}
  />
  <AsuransiSection items={(asurRes.data as unknown as Asuransi[]) ?? []} />
  <BeritaSection
    artikel={(artikelRes.data as unknown as Artikel[]) ?? []}
    berita={(beritaRes.data as unknown as Artikel[]) ?? []}
  />
  <TestimoniSection client:visible items={(testiRes.data as unknown as Testimoni[]) ?? []} />

  <section id="kontak" class="section bg-canvas">
    <div class="wrap">
      <div data-reveal class="grid lg:grid-cols-[1fr_1.2fr] gap-6">
        <div class="bg-gradient-to-br from-prima-d via-prima to-prima-l text-white rounded-3xl p-8 md:p-10 relative overflow-hidden">
          <div class="absolute -top-12 -right-12 w-64 h-64 rounded-full bg-white/10 blur-2xl"></div>
          <div class="relative">
            <span class="chip bg-white/15 text-white">Buat Janji Temu</span>
            <h2 class="mt-4 text-[clamp(26px,3vw,38px)] font-extrabold leading-tight">
              Punya pertanyaan atau ingin membuat janji?
            </h2>
            <p class="mt-3 text-white/85">
              Tim kami siap membantu Anda. Hubungi via telepon atau kirim pesan melalui formulir kontak.
            </p>
            <div class="mt-8 space-y-4">
              {info?.emergency_phone && (
                <a href={`tel:${info.emergency_phone}`} class="flex items-center gap-3 group">
                  <div class="w-11 h-11 rounded-full bg-coral flex items-center justify-center flex-shrink-0">
                    <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                      <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.4 0 .8-.2 1l-2.3 2.2z" />
                    </svg>
                  </div>
                  <div>
                    <div class="text-xs uppercase tracking-wider text-white/70">IGD 24 Jam</div>
                    <div class="font-bold group-hover:underline">{info.emergency_phone}</div>
                  </div>
                </a>
              )}
              {info?.hp && info.hp !== info.emergency_phone && (
                <a
                  href={waUrl(info.hp, "Halo RS Royal Prima Jambi, saya ingin bertanya.") || "#"}
                  target="_blank"
                  rel="noreferrer"
                  class="flex items-center gap-3 group"
                >
                  <div class="w-11 h-11 rounded-full bg-white/15 flex items-center justify-center flex-shrink-0">
                    <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                      <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.4 0 .8-.2 1l-2.3 2.2z" />
                    </svg>
                  </div>
                  <div>
                    <div class="text-xs uppercase tracking-wider text-white/70">Resepsionis (WhatsApp)</div>
                    <div class="font-bold group-hover:underline">{info.hp}</div>
                  </div>
                </a>
              )}
              {info?.location_address && (
                <div class="flex items-start gap-3">
                  <div class="w-11 h-11 rounded-full bg-white/15 flex items-center justify-center flex-shrink-0">
                    <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                      <path d="M12 2C7.6 2 4 5.6 4 10c0 5.4 7 11.5 7.3 11.8.4.3.9.3 1.3 0C13 21.5 20 15.4 20 10c0-4.4-3.6-8-8-8zm0 11a3 3 0 110-6 3 3 0 010 6z" />
                    </svg>
                  </div>
                  <div>
                    <div class="text-xs uppercase tracking-wider text-white/70">Alamat</div>
                    <div class="text-sm">{info.location_address}</div>
                  </div>
                </div>
              )}
            </div>

            <a
              href={waUrl(info?.hp, "Halo RS Royal Prima Jambi, saya ingin bertanya.") || "#kontak"}
              target="_blank"
              rel="noreferrer"
              class="btn btn-coral mt-8 w-full"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                <path d="M12 2a10 10 0 00-8.6 15L2 22l5.2-1.4A10 10 0 1012 2zm0 2a8 8 0 11-4.2 14.8l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 0112 4zm-3.4 4.3c-.2 0-.5 0-.7.3-.2.3-.9.9-.9 2.1s.9 2.4 1 2.6c.2.2 1.8 2.9 4.5 3.9 2.2.9 2.7.7 3.2.6.5 0 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2l-.7-.4c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1-.7-.3-1.4-.6-2.1-1.5-.5-.6-.9-1.3-1-1.5-.1-.2 0-.4.1-.5l.4-.5c.1-.1.1-.3.2-.4 0-.2 0-.3 0-.4l-.8-2c-.2-.5-.4-.4-.6-.4z" />
              </svg>
              Kirim Pertanyaan via WhatsApp
            </a>
          </div>
        </div>

        {info?.location_map_url && (
          <div class="card overflow-hidden min-h-[420px] lg:min-h-full">
            <iframe
              src={info.location_map_url}
              class="w-full h-full min-h-[420px]"
              style="border:0"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Lokasi RS Royal Prima Jambi"
              allowfullscreen
            ></iframe>
          </div>
        )}
      </div>
    </div>
  </section>
</SiteLayout>
