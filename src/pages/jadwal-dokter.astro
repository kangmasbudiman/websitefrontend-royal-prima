---
import SiteLayout from "../layouts/SiteLayout.astro";
import JadwalDokterSection from "../components/sections/JadwalDokter";
import { supabase } from "../lib/supabase";
import { waUrl } from "../lib/utils";
import type { Dokter, InfoCard, Jadwal } from "../lib/types";

const [dokterRes, jadwalRes, infoRes] = await Promise.all([
  supabase.from("dokter").select("*, poliklinik(*)").order("id"),
  supabase.from("jadwal").select("*").order("id"),
  supabase.from("infoCard").select("*").limit(1).maybeSingle(),
]);

const info = (infoRes.data as unknown as InfoCard | null) ?? null;
const dokter = (dokterRes.data as unknown as Dokter[]) ?? [];
const jadwal = (jadwalRes.data as unknown as Jadwal[]) ?? [];

// Hari berjalan menurut zona waktu rumah sakit (WIB / Asia-Jakarta).
const todayHari = new Intl.DateTimeFormat("id-ID", {
  weekday: "long",
  timeZone: "Asia/Jakarta",
}).format(new Date());

const dokterAktif = dokter.filter((d) => d.status !== false);
const hariIniCount = jadwal.filter((j) => j.hari === todayHari).length > 0
  ? new Set(jadwal.filter((j) => j.hari === todayHari).map((j) => j.dokterid)).size
  : 0;
---

<SiteLayout
  title="Jadwal Praktik Dokter — RS Royal Prima Jambi"
  description="Jadwal praktik dokter spesialis RS Royal Prima Jambi, diperbarui sesuai hari berjalan. Lihat dokter yang praktik hari ini lengkap dengan jam praktiknya."
>
  <!-- Header halaman dengan logo rumah sakit -->
  <section class="relative overflow-hidden bg-gradient-to-br from-prima-d via-prima to-prima-l text-white">
    <div class="absolute -top-20 -right-20 w-80 h-80 rounded-full bg-white/10 blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-16 w-96 h-96 rounded-full bg-white/5 blur-3xl pointer-events-none"></div>
    <div class="absolute top-1/3 right-1/4 w-40 h-40 rounded-full border border-white/10 pointer-events-none"></div>

    <div class="wrap relative py-12 md:py-16">
      <div class="flex flex-col md:flex-row md:items-center gap-7 md:gap-10">
        <!-- Logo RS -->
        <div class="bg-white rounded-2xl p-3 sm:p-4 shadow-xl shadow-black/15 w-fit self-start">
          <img
            src="/logo-rs.png"
            alt="RS. Royal Prima Jambi — Kesembuhan Anda adalah Kebanggaan Kami"
            width="543"
            height="149"
            class="h-12 sm:h-16 w-auto object-contain"
          />
        </div>

        <div>
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/15 text-white text-[11px] font-bold tracking-wide">
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5">
              <path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4-6.2-4.6-6.2 4.6 2.4-7.4L2 9.4h7.6z" />
            </svg>
            Informasi Praktik
          </span>
          <h1 class="mt-3 text-[clamp(28px,4vw,44px)] font-extrabold leading-tight tracking-tight text-balance">
            Jadwal Praktik Dokter
          </h1>
          <p class="mt-2 text-white/85 max-w-xl leading-relaxed">
            Daftar dokter spesialis yang praktik hari ini, lengkap dengan jam praktik dan fotonya.
            Gunakan tab hari di bawah untuk melihat jadwal hari lainnya.
          </p>
        </div>
      </div>

      <!-- Statistik singkat -->
      <div class="mt-8 flex flex-wrap gap-3">
        <div class="inline-flex items-center gap-2.5 px-4 py-2.5 rounded-2xl bg-white/10 border border-white/15 backdrop-blur">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-teal opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-teal"></span>
          </span>
          <span class="text-[13px] font-semibold text-white/85">Hari ini</span>
          <span class="text-[13px] font-extrabold">{todayHari}</span>
          <span class="text-[13px] font-bold text-teal">· {hariIniCount} dokter praktik</span>
        </div>
        <div class="inline-flex items-center gap-2.5 px-4 py-2.5 rounded-2xl bg-white/10 border border-white/15 backdrop-blur">
          <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-white/80">
            <path d="M12 21s-7.5-4.9-9.7-9.2C.8 8.7 2.6 5 6.2 5c2 0 3.4 1.1 4.2 2.4L12 9l1.6-1.6C14.4 6.1 15.8 5 17.8 5c3.6 0 5.4 3.7 3.9 6.8C19.5 16.1 12 21 12 21z" />
          </svg>
          <span class="text-[13px] font-bold">{dokterAktif.length} dokter spesialis</span>
        </div>
        <a
          href={`tel:${info?.emergency_phone || ""}`}
          class="inline-flex items-center gap-2.5 px-4 py-2.5 rounded-2xl bg-coral hover:bg-coral-d transition-colors"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
            <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.4 0 .8-.2 1l-2.3 2.2z" />
          </svg>
          <span class="text-[13px] font-bold">IGD 24 Jam {info?.emergency_phone || ""}</span>
        </a>
      </div>
    </div>
  </section>

  <JadwalDokterSection
    client:load
    items={dokter}
    jadwal={jadwal}
    waPhone={info?.hp}
    todayHari={todayHari}
  />
</SiteLayout>
