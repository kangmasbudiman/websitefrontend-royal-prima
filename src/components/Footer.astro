---
import Brand from "./Brand.astro";
import type { InfoCard } from "../lib/types";
import { waUrl } from "../lib/utils";

export interface Props {
  info: InfoCard | null;
}

const { info } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="bg-ink text-white/80 mt-20">
  <div class="wrap py-16 grid gap-10 md:grid-cols-4">
    <div class="md:col-span-1">
      <Brand light />
      <p class="mt-4 text-sm text-white/70 leading-relaxed">
        Rumah sakit swasta terpadu di Jambi dengan layanan dokter spesialis,
        IGD 24 jam, dan fasilitas medis modern.
      </p>
    </div>

    <div>
      <h4 class="font-bold text-white mb-4 text-sm tracking-wider uppercase">Layanan</h4>
      <ul class="space-y-2 text-sm">
        <li><a href="/#poliklinik" class="hover:text-prima-l">Poliklinik</a></li>
        <li><a href="/#dokter" class="hover:text-prima-l">Dokter Spesialis</a></li>
        <li><a href="/#fasilitas" class="hover:text-prima-l">Fasilitas</a></li>
        <li><a href="/#berita" class="hover:text-prima-l">Berita & Artikel</a></li>
      </ul>
    </div>

    <div>
      <h4 class="font-bold text-white mb-4 text-sm tracking-wider uppercase">Kontak</h4>
      <ul class="space-y-3 text-sm">
        {info?.location_address && (
          <li class="flex gap-2">
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 mt-0.5 text-prima-l flex-shrink-0">
              <path d="M12 2C7.6 2 4 5.6 4 10c0 5.4 7 11.5 7.3 11.8.4.3.9.3 1.3 0C13 21.5 20 15.4 20 10c0-4.4-3.6-8-8-8zm0 11a3 3 0 110-6 3 3 0 010 6z" />
            </svg>
            <span>{info.location_address}</span>
          </li>
        )}
        {info?.hp && (
          <li class="flex gap-2">
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 mt-0.5 text-[#25D366] flex-shrink-0">
              <path d="M12 2a10 10 0 00-8.6 15L2 22l5.2-1.4A10 10 0 1012 2zm0 2a8 8 0 11-4.2 14.8l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 0112 4zm-3.4 4.3c-.2 0-.5 0-.7.3-.2.3-.9.9-.9 2.1s.9 2.4 1 2.6c.2.2 1.8 2.9 4.5 3.9 2.2.9 2.7.7 3.2.6.5 0 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2l-.7-.4c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1-.7-.3-1.4-.6-2.1-1.5-.5-.6-.9-1.3-1-1.5-.1-.2 0-.4.1-.5l.4-.5c.1-.1.1-.3.2-.4 0-.2 0-.3 0-.4l-.8-2c-.2-.5-.4-.4-.6-.4z" />
            </svg>
            <a
              href={waUrl(info.hp, "Halo RS Royal Prima Jambi, saya ingin bertanya.") || "#"}
              target="_blank"
              rel="noreferrer"
              class="hover:text-white transition"
            >
              {info.hp} (WhatsApp)
            </a>
          </li>
        )}
        {info?.emergency_phone && (
          <li class="flex gap-2">
            <span class="chip bg-coral-soft text-coral">IGD 24 Jam</span>
            <span>{info.emergency_phone}</span>
          </li>
        )}
      </ul>
    </div>

    <div>
      <h4 class="font-bold text-white mb-4 text-sm tracking-wider uppercase">Jam Operasional</h4>
      <ul class="space-y-1.5 text-sm text-white/70">
        <li class="flex justify-between gap-4">
          <span>Poli Spesialis</span>
          <span class="text-white">08.00 – 14.00</span>
        </li>
        <li class="flex justify-between gap-4">
          <span>IGD</span>
          <span class="text-coral">24 Jam</span>
        </li>
        <li class="flex justify-between gap-4">
          <span>Apotek</span>
          <span class="text-white">08.00 – 21.00</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="wrap py-4 flex flex-col md:flex-row justify-between text-[12px] text-white/60">
      <span>© {year} RS Royal Prima Jambi. Seluruh hak dilindungi.</span>
      <span>Jl. Raden Wijaya, Kebun Kopi, Thehok, Jambi Selatan, Kota Jambi</span>
    </div>
  </div>
</footer>
