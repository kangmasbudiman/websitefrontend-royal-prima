---
// Brand logo. Header memakai file logo resmi; footer pakai lockup teks terang.
export interface Props {
  light?: boolean;
}

const { light = false } = Astro.props;
---

{
  light ? (
    <a href="/" class="group inline-flex flex-col leading-none">
      <span class="font-serif font-extrabold tracking-wide text-white text-[15px] whitespace-nowrap">
        RS. ROYAL PRIMA JAMBI
      </span>
      <span class="mt-1.5 flex items-center gap-2 whitespace-nowrap">
        <span class="w-1 h-1 rotate-45 bg-[#d9bd6a] flex-shrink-0" />
        <span class="font-script text-[#d9bd6a] text-[14px] leading-none">
          Kesembuhan Anda adalah Kebanggaan Kami
        </span>
        <span class="w-1 h-1 rotate-45 bg-[#d9bd6a] flex-shrink-0" />
      </span>
    </a>
  ) : (
    <a href="/" class="group inline-flex">
      <img
        src="/logo-rs.png"
        alt="RS. Royal Prima Jambi — Kesembuhan Anda adalah Kebanggaan Kami"
        width="543"
        height="149"
        class="h-11 sm:h-[52px] w-auto object-contain group-hover:scale-[1.02] transition-transform"
      />
    </a>
  )
}
