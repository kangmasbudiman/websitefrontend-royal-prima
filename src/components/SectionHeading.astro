---
export interface Props {
  eyebrow?: string;
  title: string;
  desc?: string;
  center?: boolean;
}

const { eyebrow, title, desc, center = false } = Astro.props;
---

<div
  data-reveal
  class={`mb-10 ${center ? "text-center max-w-2xl mx-auto" : "max-w-2xl"}`}
>
  {eyebrow && (
    <div class={`eyebrow mb-3 ${center ? "justify-center" : ""}`}>{eyebrow}</div>
  )}
  <h2 class="text-[clamp(28px,3.6vw,44px)] font-extrabold leading-tight tracking-tight text-balance">
    {title}
  </h2>
  {desc && <p class="mt-3 text-muted text-[16px] leading-relaxed">{desc}</p>}
</div>
