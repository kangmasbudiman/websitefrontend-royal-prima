---
import Brand from "./Brand.astro";
import { waUrl } from "../lib/utils";

export interface Props {
  emergencyPhone?: string | null;
  hp?: string | null;
}

const { emergencyPhone, hp } = Astro.props;

const kontakHref = waUrl(hp, "Halo RS Royal Prima Jambi, saya ingin bertanya.") || "#kontak";

const NAV = [
  { href: "/", label: "Beranda" },
  { href: "/#tentang", label: "Tentang" },
  { href: "/#poliklinik", label: "Poliklinik" },
  { href: "/#dokter", label: "Dokter" },
  { href: "/#fasilitas", label: "Fasilitas" },
  { href: "/#berita", label: "Berita" },
  { href: kontakHref, label: "Kontak", wa: true },
];
---

<header data-nav class="sticky top-0 z-40 bg-paper/95 backdrop-blur border-b border-line">
  <div class="wrap flex items-center justify-between py-3">
    <Brand />

    <nav class="hidden lg:flex items-center gap-7 text-[14px] font-semibold text-ink-soft">
      {NAV.map((l) => (
        <a
          href={l.href}
          target={l.wa ? "_blank" : undefined}
          rel={l.wa ? "noreferrer" : undefined}
          class="hover:text-prima transition inline-flex items-center gap-1"
        >
          {l.wa && (
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-[#25D366]">
              <path d="M12 2a10 10 0 00-8.6 15L2 22l5.2-1.4A10 10 0 1012 2zm0 2a8 8 0 11-4.2 14.8l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 0112 4zm-3.4 4.3c-.2 0-.5 0-.7.3-.2.3-.9.9-.9 2.1s.9 2.4 1 2.6c.2.2 1.8 2.9 4.5 3.9 2.2.9 2.7.7 3.2.6.5 0 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2l-.7-.4c-.3-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1-.7-.3-1.4-.6-2.1-1.5-.5-.6-.9-1.3-1-1.5-.1-.2 0-.4.1-.5l.4-.5c.1-.1.1-.3.2-.4 0-.2 0-.3 0-.4l-.8-2c-.2-.5-.4-.4-.6-.4z" />
            </svg>
          )}
          {l.label}
        </a>
      ))}
    </nav>

    <div class="hidden lg:flex items-center gap-3">
      {emergencyPhone && (
        <a href={`tel:${emergencyPhone}`} class="btn btn-coral">
          <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
            <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.4 0 .8-.2 1l-2.3 2.2z" />
          </svg>
          IGD {emergencyPhone}
        </a>
      )}
    </div>

    <button
      type="button"
      data-nav-toggle
      aria-label="Menu"
      aria-expanded="false"
      class="lg:hidden p-2"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </div>

  <div data-nav-menu class="hidden lg:hidden border-t border-line bg-paper">
    <div class="wrap py-4 flex flex-col gap-1">
      {NAV.map((l) => (
        <a
          href={l.href}
          data-nav-link
          target={l.wa ? "_blank" : undefined}
          rel={l.wa ? "noreferrer" : undefined}
          class="py-2 px-2 rounded hover:bg-canvas"
        >
          {l.label}
        </a>
      ))}
      {emergencyPhone && (
        <a href={`tel:${emergencyPhone}`} class="btn btn-coral mt-3 w-full">
          Panggilan Darurat {emergencyPhone}
        </a>
      )}
    </div>
  </div>
</header>

<script>
  const setup = () => {
    const header = document.querySelector<HTMLElement>("[data-nav]");
    if (!header) return;
    const toggle = header.querySelector<HTMLButtonElement>("[data-nav-toggle]");
    const menu = header.querySelector<HTMLElement>("[data-nav-menu]");
    const links = header.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");
    if (!toggle || !menu) return;

    const close = () => {
      menu.classList.add("hidden");
      toggle.setAttribute("aria-expanded", "false");
    };
    const open = () => {
      menu.classList.remove("hidden");
      toggle.setAttribute("aria-expanded", "true");
    };

    toggle.addEventListener("click", () => {
      if (menu.classList.contains("hidden")) open();
      else close();
    });
    links.forEach((l) => l.addEventListener("click", close));

    // Close on resize to lg+
    const mql = window.matchMedia("(min-width: 1024px)");
    mql.addEventListener("change", (e) => {
      if (e.matches) {
        menu.classList.remove("hidden");
        toggle.setAttribute("aria-expanded", "false");
      } else {
        close();
      }
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setup);
  } else {
    setup();
  }
  document.addEventListener("astro:page-load", setup);
</script>
