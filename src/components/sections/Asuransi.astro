---
import type { Asuransi } from "../../lib/types";
import { gambarPertama } from "../../lib/utils";

export interface Props {
  items: Asuransi[];
}

const { items } = Astro.props;
if (items.length === 0) return null;

// Duplicate for seamless marquee loop
const loop = [...items, ...items];
---

<section class="section-tight border-y border-line bg-paper">
  <div class="wrap">
    <div data-reveal class="text-center mb-8">
      <span class="eyebrow justify-center inline-flex">Asuransi Kesehatan</span>
      <h2 class="mt-3 text-2xl md:text-3xl font-extrabold">
        Bekerja sama dengan berbagai penjamin
      </h2>
    </div>
  </div>
  <div class="relative overflow-hidden">
    <div class="flex gap-6 animate-marquee w-max">
      {loop.map((a) => {
        const logo = gambarPertama(a.logo);
        return (
          <div
            class="flex-shrink-0 w-44 h-20 bg-white border border-line rounded-xl flex items-center justify-center p-4"
          >
            {logo ? (
              <img src={logo} alt={a.nama_asuransi} class="max-h-full max-w-full object-contain" />
            ) : (
              <span class="font-bold text-ink-soft text-sm text-center">{a.nama_asuransi}</span>
            )}
          </div>
        );
      })}
    </div>
  </div>
</section>
