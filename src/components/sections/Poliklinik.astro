---
import type { Poliklinik, Dokter, Jadwal } from "../../lib/types";
import { gambarPertama, waUrl } from "../../lib/utils";

export interface Props {
  items: Poliklinik[];
  dokter?: Dokter[];
  jadwal?: Jadwal[];
  waPhone?: string | null;
}

const { items, dokter = [], jadwal = [], waPhone } = Astro.props;
if (items.length === 0) return null;

// === Helpers: derive doctor + schedule info per poliklinik ===
const DAYS = ["Minggu", "Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu"];
const todayIdx = new Date().getDay();
const todayName = DAYS[todayIdx];

function poliDoctors(poliId: number | null): Dokter[] {
  if (poliId == null) return [];
  return dokter.filter((d) => d.poliklinikid === poliId && d.status !== false);
}

function nextSchedule(poliId: number | null): { hari: string; jam: string } | null {
  const docs = poliDoctors(poliId);
  if (!docs.length) return null;
  const ids = new Set(docs.map((d) => d.id));
  const js = jadwal.filter((j) => ids.has(j.dokterid));
  if (!js.length) return null;

  const order = [...DAYS.slice(todayIdx), ...DAYS.slice(0, todayIdx)];
  const todayJs = js.filter((j) => j.hari === todayName).sort((a, b) => a.jamMulai.localeCompare(b.jamMulai));
  const upcoming = order.slice(1).map((d) => js.filter((j) => j.hari === d).sort((a, b) => a.jamMulai.localeCompare(b.jamMulai))).flat();

  const pick = todayJs[0] ?? upcoming[0];
  if (!pick) return null;
  return { hari: pick.hari, jam: `${pick.jamMulai.slice(0, 5)}–${pick.jamSelesai.slice(0, 5)}` };
}

function shortName(nama: string): string {
  return nama
    .replace(/^dr\.?\s*/i, "")
    .replace(/^DR\.?\s+/i, "")
    .replace(/^Prof\.?\s+/i, "")
    .trim();
}

function specialistCode(nama: string): string | null {
  const m = nama.match(/[Ss][Pp]\.?\s*([A-Z]{1,3}(?:[-/][A-Z]{1,3})?)/);
  return m ? `Sp.${m[1]}` : null;
}

function stripTags(s: string | null): string {
  return s ? s.replace(/<[^>]+>/g, "") : "";
}

// === Specialty icons — stroke SVG (24x24), dipetakan dari nama klinik ===
const SPECIALTY_ICONS: { keys: string[]; paths: string[] }[] = [
  {
    keys: ["jantung", "kardio", "cardio"],
    paths: [
      "M12 20.5S3.5 15.5 3.5 9.4C3.5 6.5 5.7 4.5 8 4.5c1.7 0 3.2 1 4 2.4.8-1.4 2.3-2.4 4-2.4 2.3 0 4.5 2 4.5 4.9 0 6.1-8.5 11.1-8.5 11.1z",
    ],
  },
  {
    keys: ["mata", "ophthalm"],
    paths: [
      "M1.8 12S5.5 5.8 12 5.8 22.2 12 22.2 12 18.5 18.2 12 18.2 1.8 12 1.8 12z",
      "M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z",
    ],
  },
  {
    keys: ["anak", "bayi"],
    paths: [
      "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z",
      "M9 10h.01",
      "M15 10h.01",
      "M8.5 14s1.3 1.8 3.5 1.8S15.5 14 15.5 14",
    ],
  },
  {
    keys: ["paru", "respirasi", "pulmo"],
    paths: [
      "M12 4v8.5",
      "M12 12.5c-1-1.7-2.4-2.6-4-2.6-2.1 0-3 2.2-3 4.6 0 2.1.6 4.9 2.3 4.9 1.5 0 2.1-1.4 2.7-3.1",
      "M12 12.5c1-1.7 2.4-2.6 4-2.6 2.1 0 3 2.2 3 4.6 0 2.1-.6 4.9-2.3 4.9-1.5 0-2.1-1.4-2.7-3.1",
    ],
  },
  { keys: ["tht", "telinga", "hidung", "ent"], paths: ["M4 10v4", "M8 7v10", "M12 4.5v15", "M16 7v10", "M20 10v4"] },
  { keys: ["syaraf", "jiwa", "neuro"], paths: ["M13 2 4.5 13.5H11L9.5 22 19 10h-6.5L13 2z"] },
  {
    keys: ["kandungan", "obg", "kebidanan", "perempuan"],
    paths: ["M12 13.5a5 5 0 1 0 0-10 5 5 0 0 0 0 10z", "M12 13.5V22", "M8.5 18.5h7"],
  },
  {
    keys: ["gigi", "dental", "odonto"],
    paths: [
      "M12 5.5c-1.8-1.2-3-2-5-2C4.5 3.5 3 5.3 3 7.7c0 3 1.5 4.9 2 7.7.4 2.2.8 6.1 2.4 6.1 1.7 0 1.4-3.6 1.4-5.6 0-1.7 1.5-1.9 3.2-1.9s3.2.2 3.2 1.9c0 2-.3 5.6 1.4 5.6 1.6 0 2-3.9 2.4-6.1.5-2.8 2-4.7 2-7.7 0-2.4-1.5-4.2-4-4.2-2 0-3.2.8-5 2z",
    ],
  },
  { keys: ["bedah", "surgery"], paths: ["M12 5.5v13", "M5.5 12h13"] },
  { keys: ["tulang", "orthopedi", "ortopedi", "ortho"], paths: ["M3.5 12H7l2.5-6.5L14 18l2-6h4.5"] },
];
const DEFAULT_ICON = [
  "M4.5 3v5.5a6 6 0 0 0 12 0V3",
  "M10.5 14.5V17a5 5 0 0 0 10 0v-2",
  "M20.5 13a2 2 0 1 0-4 0 2 2 0 0 0 4 0z",
];

function specialtyIcon(nama: string): string[] {
  const n = nama.toLowerCase();
  for (const e of SPECIALTY_ICONS) {
    if (e.keys.some((k) => n.includes(k))) return e.paths;
  }
  return DEFAULT_ICON;
}

// Palet tile ikon (di-cycle biar variatif)
const TILES = [
  { grad: "from-prima to-teal", soft: "bg-prima-soft", text: "text-prima-d" },
  { grad: "from-coral to-coral-d", soft: "bg-coral-soft", text: "text-coral-d" },
  { grad: "from-teal to-prima", soft: "bg-teal/10", text: "text-teal" },
] as const;

// Group jadwal per dokter, sorted by day-of-week
const DAY_ORDER = ["Minggu", "Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu"];
function dokterJadwal(dokterId: number | null) {
  if (dokterId == null) return [];
  return jadwal
    .filter((j) => j.dokterid === dokterId)
    .sort((a, b) => DAY_ORDER.indexOf(a.hari) - DAY_ORDER.indexOf(b.hari))
    .map((j) => ({ hari: j.hari, jam: `${j.jamMulai.slice(0, 5)}–${j.jamSelesai.slice(0, 5)}` }));
}

// Pre-build full clinic data for the modal
const clinicData = items.map((p, idx) => {
  const docs = poliDoctors(p.id);
  return {
    id: p.id,
    nama: p.nama,
    deskripsi: stripTags(p.deskripsi),
    lokasi: p.lokasi ?? null,
    img: gambarPertama(p.poto) || null,
    icon: specialtyIcon(p.nama),
    grad: TILES[idx % TILES.length].grad,
    doctors: docs.map((d) => ({
      shortNama: shortName(d.nama),
      code: specialistCode(d.nama),
      spesialist: d.spesialist ?? null,
      initial: shortName(d.nama).match(/^[A-Za-z]/)?.[0] ?? "?",
      photo: gambarPertama(d.potourl) || null,
      schedules: dokterJadwal(d.id),
    })),
  };
});

const dokterAktif = dokter.filter((d) => d.status !== false).length;

// Featured = poliklinik pertama
const featured = items[0];
const featuredImg = gambarPertama(featured.poto);
const featuredIcon = specialtyIcon(featured.nama);
const featuredDocs = poliDoctors(featured.id);
const featuredSched = nextSchedule(featured.id);
const featuredCodes = [...new Set(featuredDocs.map((d) => specialistCode(d.nama)).filter(Boolean))] as string[];
const rest = items.slice(1);
---

<section id="poliklinik" class="section relative overflow-hidden">
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-canvas via-paper to-canvas"></div>
  <div class="absolute top-40 -left-32 w-96 h-96 rounded-full bg-prima-soft/50 blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-40 -right-32 w-96 h-96 rounded-full bg-coral-soft/40 blur-3xl pointer-events-none"></div>

  <div class="wrap">
    {/* Magazine-style header */}
    <div class="grid lg:grid-cols-[1fr_auto] gap-6 items-end mb-10 lg:mb-12">
      <div data-reveal>
        <div class="eyebrow mb-4">
          <span class="w-8 h-px bg-coral"></span>
          Layanan Medis
        </div>
        <h2 class="text-[clamp(32px,4.5vw,56px)] font-extrabold leading-[1.02] tracking-tight text-balance max-w-2xl">
          Poliklinik
          <span class="block text-prima">Spesialis Terpadu</span>
        </h2>
      </div>
      <div data-reveal data-reveal-delay="100" class="flex flex-col lg:items-end gap-3">
        <p class="text-ink-soft/75 text-[15px] leading-relaxed max-w-sm lg:text-right">
          {items.length} klinik spesialis ditempati {dokterAktif} dokter berpengalaman — pilih klinik untuk melihat jadwal praktik.
        </p>
        <a href="#dokter" class="hidden lg:inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-ink text-white text-sm font-bold hover:bg-prima-d transition-colors">
          Lihat Semua Dokter
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>

    {/* === FEATURED — kartu utama klinik pertama === */}
    <button
      type="button"
      data-clinic-open={featured.id}
      data-reveal
      class="group relative w-full overflow-hidden rounded-[28px] border border-line bg-white shadow-[0_24px_60px_-30px_rgba(15,31,58,0.28)] hover:shadow-[0_34px_80px_-30px_rgba(15,31,58,0.38)] hover:-translate-y-1 transition-all duration-500 mb-4 lg:mb-6 block text-left cursor-pointer"
    >
      <div class="absolute inset-0 bg-gradient-to-r from-prima-soft/80 via-white/50 to-coral-soft/50 pointer-events-none"></div>

      {/* Watermark ikon spesialis */}
      <div class="absolute -right-8 -bottom-10 w-72 h-72 text-prima/[0.06] rotate-12 group-hover:rotate-6 group-hover:scale-110 transition-transform duration-700 pointer-events-none">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full" aria-hidden="true">
          {featuredIcon.map((d) => <path d={d} />)}
        </svg>
      </div>

      <div class="relative grid lg:grid-cols-[auto_1fr_auto] gap-6 lg:gap-10 items-center p-6 lg:p-9">
        {/* Tile: foto dari admin, kalau tidak ada → tile ikon gradien */}
        {featuredImg ? (
          <div class="w-24 h-24 lg:w-28 lg:h-28 rounded-[24px] overflow-hidden border-4 border-white shadow-lg shadow-prima/20 flex-shrink-0">
            <img
              src={featuredImg}
              alt={featured.nama}
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
        ) : (
          <div class="w-24 h-24 lg:w-28 lg:h-28 rounded-[24px] bg-gradient-to-br from-prima to-teal text-white flex items-center justify-center shadow-lg shadow-prima/30 flex-shrink-0 group-hover:rotate-3 group-hover:scale-105 transition-transform duration-500">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-11 h-11 lg:w-12 lg:h-12" aria-hidden="true">
              {featuredIcon.map((d) => <path d={d} />)}
            </svg>
          </div>
        )}

        {/* Konten tengah */}
        <div class="min-w-0">
          <div class="flex items-center gap-2 mb-2">
            <span class="h-px w-8 bg-coral"></span>
            <span class="text-[10px] uppercase tracking-[0.22em] font-bold text-coral">Klinik Utama</span>
          </div>
          <h3 class="font-extrabold text-[clamp(24px,3.2vw,38px)] leading-[1.05] tracking-tight text-ink text-balance">
            {featured.nama}
          </h3>
          {featured.deskripsi && (
            <p class="mt-2 text-ink-soft/80 text-[14px] lg:text-[15px] leading-relaxed max-w-xl line-clamp-2">
              {stripTags(featured.deskripsi)}
            </p>
          )}
          <div class="mt-4 flex flex-wrap items-center gap-2">
            {featuredDocs.length > 0 && (
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-coral text-white text-[11px] font-bold shadow-sm">
                <svg viewBox="0 0 24 24" fill="currentColor" class="w-3 h-3">
                  <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                </svg>
                {featuredDocs.length} Dokter Spesialis
              </span>
            )}
            {featured.lokasi && (
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/80 border border-line text-ink-soft text-[11px] font-bold">
                <svg viewBox="0 0 24 24" fill="currentColor" class="w-3 h-3 text-prima">
                  <path d="M12 2C7.6 2 4 5.6 4 10c0 5.4 7 11.5 7.3 11.8.4.3.9.3 1.3 0C13 21.5 20 15.4 20 10c0-4.4-3.6-8-8-8zm0 11a3 3 0 110-6 3 3 0 010 6z" />
                </svg>
                {featured.lokasi}
              </span>
            )}
            {featuredSched && (
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-teal/10 text-teal text-[11px] font-bold">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3">
                  <circle cx="12" cy="12" r="10" />
                  <path d="M12 6v6l4 2" />
                </svg>
                {featuredSched.hari === todayName ? "Hari ini" : featuredSched.hari}
                <span class="font-mono">{featuredSched.jam}</span>
              </span>
            )}
            {featuredCodes.slice(0, 4).map((c) => (
              <span class="px-2 py-1 rounded-md bg-ink/5 border border-line text-ink-soft text-[10px] font-bold font-mono tracking-wide">{c}</span>
            ))}
          </div>
        </div>

        {/* Kanan: stack dokter + CTA */}
        <div class="flex lg:flex-col items-center gap-4 lg:gap-4 justify-between w-full lg:w-auto">
          {featuredDocs.length > 0 && (
            <div class="flex -space-x-3">
              {featuredDocs.slice(0, 4).map((d) => {
                const photo = gambarPertama(d.potourl);
                const initial = shortName(d.nama).match(/^[A-Za-z]/)?.[0] ?? "?";
                return (
                  <div class="relative w-11 h-11 rounded-full bg-white border border-line shadow-sm overflow-hidden flex items-center justify-center flex-shrink-0">
                    {photo ? (
                      <img src={photo} alt={shortName(d.nama)} loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
                    ) : (
                      <span class="text-[12px] font-extrabold text-prima">{initial}</span>
                    )}
                  </div>
                );
              })}
              {featuredDocs.length > 4 && (
                <div class="w-11 h-11 rounded-full bg-ink text-white flex items-center justify-center text-[10px] font-extrabold border-2 border-white flex-shrink-0">
                  +{featuredDocs.length - 4}
                </div>
              )}
            </div>
          )}
          <span class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-ink text-white text-sm font-bold group-hover:bg-coral transition-colors whitespace-nowrap shadow-lg">
            Lihat Dokter
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 group-hover:translate-x-1 transition-transform">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </span>
        </div>
      </div>
    </button>

    {/* === DIRECTORY ROWS — daftar klinik spesialis === */}
    <div class="grid sm:grid-cols-2 gap-4">
      {rest.map((p, idx) => {
        const dbImg = gambarPertama(p.poto);
        const icon = specialtyIcon(p.nama);
        const tile = TILES[idx % TILES.length];
        const docs = poliDoctors(p.id);
        const sched = nextSchedule(p.id);
        const codes = [...new Set(docs.map((d) => specialistCode(d.nama)).filter(Boolean))] as string[];
        const num = String(idx + 2).padStart(2, "0");

        return (
          <button
            type="button"
            data-clinic-open={p.id}
            data-reveal
            data-reveal-delay={(idx % 4) * 70}
            class="group relative overflow-hidden rounded-2xl border border-line bg-white p-4 lg:p-5 flex items-center gap-4 hover:border-prima/40 hover:shadow-[0_20px_50px_-25px_rgba(15,31,58,0.35)] hover:-translate-y-1 transition-all duration-300 text-left cursor-pointer"
          >
            <span class="absolute top-3 right-4 font-mono text-[11px] font-extrabold text-ink/15 group-hover:text-coral transition-colors">
              {num}
            </span>

            {/* Tile: foto admin atau ikon gradien */}
            {dbImg ? (
              <div class="w-14 h-14 lg:w-16 lg:h-16 rounded-2xl overflow-hidden flex-shrink-0 border border-line bg-canvas">
                <img
                  src={dbImg}
                  alt={p.nama}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                />
              </div>
            ) : (
              <div class={`w-14 h-14 lg:w-16 lg:h-16 rounded-2xl bg-gradient-to-br ${tile.grad} text-white flex items-center justify-center flex-shrink-0 shadow-md group-hover:-rotate-3 group-hover:scale-105 transition-transform duration-300`}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7" aria-hidden="true">
                  {icon.map((d) => <path d={d} />)}
                </svg>
              </div>
            )}

            {/* Info */}
            <div class="min-w-0 flex-1">
              <h3 class="font-extrabold text-[15px] lg:text-base leading-tight tracking-tight text-ink truncate group-hover:text-prima-d transition-colors">
                {p.nama}
              </h3>
              {codes.length > 0 && (
                <div class="mt-1.5 flex flex-wrap gap-1">
                  {codes.slice(0, 3).map((c) => (
                    <span class={`px-1.5 py-0.5 rounded-md ${tile.soft} ${tile.text} text-[9px] font-bold font-mono tracking-wide`}>{c}</span>
                  ))}
                  {codes.length > 3 && (
                    <span class="px-1.5 py-0.5 rounded-md bg-canvas text-ink-soft/70 text-[9px] font-bold">+{codes.length - 3}</span>
                  )}
                </div>
              )}
              <div class="mt-2 text-[11px] text-ink-soft/80 font-semibold">
                {sched ? (
                  <span class="inline-flex items-center gap-1.5 min-w-0">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 text-teal flex-shrink-0">
                      <circle cx="12" cy="12" r="10" />
                      <path d="M12 6v6l4 2" />
                    </svg>
                    <span class="truncate">
                      {sched.hari === todayName ? "Hari ini" : sched.hari}
                      <span class="font-mono ml-1">{sched.jam}</span>
                    </span>
                  </span>
                ) : docs.length > 0 ? (
                  <span class="inline-flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-coral"></span>
                    {docs.length} dokter · lihat jadwal
                  </span>
                ) : (
                  <span class="italic text-ink-soft/50">Lihat detail klinik</span>
                )}
              </div>
            </div>

            {/* Stack dokter (sm ke atas) */}
            {docs.length > 0 && (
              <div class="hidden sm:flex -space-x-2.5 flex-shrink-0">
                {docs.slice(0, 3).map((d) => {
                  const photo = gambarPertama(d.potourl);
                  const initial = shortName(d.nama).match(/^[A-Za-z]/)?.[0] ?? "?";
                  return (
                    <div class="relative w-9 h-9 rounded-full bg-canvas border border-line overflow-hidden flex items-center justify-center flex-shrink-0">
                      {photo ? (
                        <img src={photo} alt={shortName(d.nama)} loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
                      ) : (
                        <span class="text-[10px] font-extrabold text-ink-soft">{initial}</span>
                      )}
                    </div>
                  );
                })}
                {docs.length > 3 && (
                  <div class="w-9 h-9 rounded-full bg-prima text-white flex items-center justify-center text-[9px] font-extrabold border-2 border-white flex-shrink-0">
                    +{docs.length - 3}
                  </div>
                )}
              </div>
            )}

            {/* Panah */}
            <span class="w-9 h-9 rounded-xl bg-canvas text-ink-soft group-hover:bg-coral group-hover:text-white group-hover:translate-x-0.5 flex items-center justify-center transition-all flex-shrink-0">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </span>
          </button>
        );
      })}
    </div>

    {/* Mobile CTA */}
    <div class="mt-8 text-center lg:hidden">
      <a href="#dokter" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-ink text-white text-sm font-bold">
        Lihat Semua Dokter
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    </div>
  </div>

  {/* === Hidden per-clinic templates (rendered server-side, swapped on click) === */}
  <div class="hidden" aria-hidden="true">
    {clinicData.map((c) => (
      <template id={`clinic-content-${c.id}`}>
        <div class="flex flex-col max-h-[90vh] lg:max-h-[85vh]">
          {/* Image / gradient header */}
          <div class="relative h-40 lg:h-52 overflow-hidden flex-shrink-0 bg-ink">
            {c.img ? (
              <img src={c.img} alt="" class="absolute inset-0 w-full h-full object-cover" />
            ) : (
              <div class={`absolute inset-0 bg-gradient-to-br ${c.grad}`}>
                <div class="absolute inset-0 flex items-center justify-center opacity-25">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="w-24 h-24 text-white" aria-hidden="true">
                    {c.icon.map((d) => <path d={d} />)}
                  </svg>
                </div>
              </div>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/70 to-ink/15"></div>
            <div class="absolute bottom-0 left-0 right-0 p-5 lg:p-7 text-white">
              <div class="flex items-center gap-2 mb-1.5">
                <span class="h-px w-6 bg-coral"></span>
                <span class="text-[10px] uppercase tracking-[0.22em] font-bold text-coral-300">Klinik Spesialis</span>
              </div>
              <h3 class="text-[22px] lg:text-[30px] font-extrabold leading-[1.1] tracking-tight drop-shadow-lg">{c.nama}</h3>
              {c.deskripsi && (
                <p class="text-white/80 text-[13px] lg:text-sm mt-2 max-w-xl line-clamp-2 leading-relaxed">{c.deskripsi}</p>
              )}
              <div class="mt-3 flex flex-wrap gap-2 text-[11px]">
                {c.lokasi && (
                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-white/15 backdrop-blur-md border border-white/25 text-white font-semibold">
                    <svg viewBox="0 0 24 24" fill="currentColor" class="w-3 h-3 text-teal-300">
                      <path d="M12 2C7.6 2 4 5.6 4 10c0 5.4 7 11.5 7.3 11.8.4.3.9.3 1.3 0C13 21.5 20 15.4 20 10c0-4.4-3.6-8-8-8zm0 11a3 3 0 110-6 3 3 0 010 6z" />
                    </svg>
                    {c.lokasi}
                  </span>
                )}
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-coral/95 text-white font-bold shadow-sm">
                  <svg viewBox="0 0 24 24" fill="currentColor" class="w-3 h-3">
                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                  </svg>
                  {c.doctors.length} Dokter
                </span>
              </div>
            </div>
          </div>

          {/* Doctor list */}
          <div class="p-5 lg:p-6 overflow-y-auto">
            <div class="flex items-center justify-between mb-4">
              <h4 class="font-extrabold text-base lg:text-lg flex items-center gap-2">
                Daftar Dokter
              </h4>
              <span class="text-[11px] uppercase tracking-wider font-bold text-ink-soft/70">
                Klik kartu untuk detail
              </span>
            </div>
            {c.doctors.length === 0 ? (
              <div class="text-center py-10">
                <div class="w-14 h-14 mx-auto rounded-2xl bg-canvas flex items-center justify-center text-ink-soft/50">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-7 h-7">
                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                  </svg>
                </div>
                <p class="mt-3 text-sm text-ink-soft font-semibold">Belum ada dokter terdaftar</p>
                <p class="mt-1 text-xs text-ink-soft/60">Hubungi RS untuk informasi terbaru</p>
              </div>
            ) : (
              <div class="space-y-3">
                {c.doctors.map((d, i) => {
                  const accent = TILES[i % TILES.length];
                  const todaySched = d.schedules.find((s) => s.hari === todayName);
                  return (
                    <div class={`flex items-start gap-4 p-4 rounded-2xl bg-canvas border border-line/60 hover:border-line hover:bg-white transition-all`}>
                      <div class={`relative w-14 h-14 rounded-2xl ${d.photo ? "" : `${accent.soft} ${accent.text}`} flex items-center justify-center font-extrabold text-lg flex-shrink-0 overflow-hidden`}>
                        {d.photo ? (
                          <img
                            src={d.photo}
                            alt={d.shortNama}
                            loading="lazy"
                            class="absolute inset-0 w-full h-full object-cover"
                          />
                        ) : (
                          <span>{d.initial}</span>
                        )}
                        {todaySched && (
                          <span class="absolute -top-1 -right-1 flex h-3.5 w-3.5">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-teal opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-teal border-2 border-canvas"></span>
                          </span>
                        )}
                      </div>
                      <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                          <span class="font-extrabold text-ink text-[15px]">{d.shortNama}</span>
                          {d.code && (
                            <span class={`px-1.5 py-0.5 rounded-md ${accent.soft} ${accent.text} text-[10px] font-bold tracking-wide font-mono`}>{d.code}</span>
                          )}
                          {todaySched && (
                            <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md bg-teal/10 text-teal text-[10px] font-bold uppercase tracking-wide">
                              <span class="w-1 h-1 rounded-full bg-teal animate-pulse"></span>
                              Praktik Hari Ini
                            </span>
                          )}
                        </div>
                        {d.spesialist && !d.code && (
                          <div class="text-xs text-ink-soft mt-0.5">{d.spesialist}</div>
                        )}
                        <div class="mt-2.5 flex flex-wrap gap-1.5">
                          {d.schedules.length === 0 ? (
                            <span class="text-xs text-ink-soft/60 italic">Jadwal belum tersedia</span>
                          ) : (
                            d.schedules.map((s) => (
                              <span class={`inline-flex items-center gap-1.5 px-2 py-1 rounded-md border text-[11px] font-semibold ${s.hari === todayName ? "bg-teal/10 border-teal/30 text-teal" : "bg-white border-line text-ink-soft"}`}>
                                <span class={s.hari === todayName ? "" : "text-ink-soft/70"}>{s.hari.slice(0, 3)}</span>
                                <span class="font-mono">{s.jam}</span>
                              </span>
                            ))
                          )}
                        </div>
                      </div>
                    </div>
                  );
                })}
              </div>
            )}

            {/* Footer CTA */}
            <div class="mt-5 pt-5 border-t border-line flex flex-col sm:flex-row gap-3 items-center justify-between">
              <p class="text-xs text-ink-soft/70 text-center sm:text-left">
                Butuh bantuan? Hubungi resepsionis untuk membuat janji.
              </p>
              <a
                href={waUrl(waPhone, `Halo RS Royal Prima Jambi, saya ingin membuat janji temu di ${c.nama}.`) || "#kontak"}
                target="_blank"
                rel="noreferrer"
                class="modal-close-cta inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-gradient-to-r from-coral to-coral-d text-white text-sm font-bold shadow-lg shadow-coral/30 hover:-translate-y-0.5 transition-all whitespace-nowrap"
              >
                Buat Janji
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </template>
    ))}
  </div>

  {/* === Modal shell === */}
  <div id="clinic-modal" class="hidden fixed inset-0 z-[100]" role="dialog" aria-modal="true" aria-labelledby="clinic-modal-title">
    <div class="absolute inset-0 bg-ink/80 backdrop-blur-sm clinic-modal-backdrop"></div>
    <div class="relative h-full w-full flex items-center justify-center p-3 sm:p-4">
      <div class="clinic-modal-dialog relative w-full max-w-3xl max-h-[94vh] bg-white rounded-3xl overflow-hidden shadow-[0_40px_100px_-20px_rgba(0,0,0,0.6)] flex flex-col">
        <button
          type="button"
          class="clinic-modal-close absolute top-3 right-3 z-20 w-10 h-10 rounded-full bg-white/15 backdrop-blur-md border border-white/25 text-white flex items-center justify-center hover:bg-white/30 hover:scale-105 transition-all shadow-lg"
          aria-label="Tutup"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="w-4 h-4">
            <path d="M18 6L6 18M6 6l12 12" />
          </svg>
        </button>
        <div class="clinic-modal-content"></div>
      </div>
    </div>
  </div>
</section>

<script>
  const modal = document.getElementById('clinic-modal');
  const modalContent = modal?.querySelector('.clinic-modal-content');
  let lastFocused: HTMLElement | null = null;

  function openClinicModal(id: string) {
    if (!modal || !modalContent) return;
    const tpl = document.getElementById(`clinic-content-${id}`);
    if (!tpl || !('content' in tpl)) return;
    modalContent.innerHTML = '';
    modalContent.appendChild((tpl as HTMLTemplateElement).content.cloneNode(true));
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    lastFocused = document.activeElement as HTMLElement;
    modal.querySelector<HTMLElement>('.clinic-modal-close')?.focus();
  }

  function closeClinicModal() {
    if (!modal) return;
    modal.classList.add('hidden');
    document.body.style.overflow = '';
    modalContent && (modalContent.innerHTML = '');
    lastFocused?.focus();
  }

  document.querySelectorAll('[data-clinic-open]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      const id = el.getAttribute('data-clinic-open');
      if (id) openClinicModal(id);
    });
  });

  modal?.querySelector('.clinic-modal-close')?.addEventListener('click', closeClinicModal);
  modal?.querySelector('.clinic-modal-backdrop')?.addEventListener('click', closeClinicModal);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeClinicModal();
    }
  });

  // Delegate clicks for "Buat Janji" CTA inside modal (since content is cloned dynamically)
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('.modal-close-cta')) {
      closeClinicModal();
    }
  });
</script>
