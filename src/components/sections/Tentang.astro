---
import type { Tentangkami, Statistik } from "../../lib/types";
import { gambarPertama, parseGambar } from "../../lib/utils";

export interface Props {
  items: Tentangkami[];
  stats?: Statistik[];
}

const { items, stats = [] } = Astro.props;
const aktif = items.filter((t) => t.status !== false).slice(0, 3);
if (aktif.length === 0) return null;

// Statistik "Komitmen Kami" — dari tabel statistik (admin), fallback default
const komitmenStats =
  stats.length > 0
    ? stats.slice(0, 4).map((s) => ({ ikon: s.ikon, nilai: s.nilai, label: s.label }))
    : [
        { ikon: "tahun", nilai: "15+", label: "Tahun" },
        { ikon: "dokter", nilai: "30+", label: "Spesialis" },
        { ikon: "igd", nilai: "24/7", label: "IGD" },
      ];

const STAT_ICON_PATHS: Record<string, string> = {
  dokter:
    "M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0 2c-4.4 0-8 1.8-8 4v3h16v-3c0-2.2-3.6-4-8-4z",
  poliklinik:
    "M4 21V8l8-5 8 5v13M4 21h16M9.5 10h.01M14.5 10h.01M9.5 13.5h.01M14.5 13.5h.01M10 21v-4h4v4",
  igd: "M3.5 12H7l2.5-6.5L14 18l2-6h4.5",
  tahun:
    "M7 2.5v3M17 2.5v3M3.5 9.5h17M5 4.5h14a1.5 1.5 0 0 1 1.5 1.5v13a1.5 1.5 0 0 1-1.5 1.5H5A1.5 1.5 0 0 1 3.5 19V6A1.5 1.5 0 0 1 5 4.5z",
  pasien:
    "M12 20.5S3.5 15.5 3.5 9.4C3.5 6.5 5.7 4.5 8 4.5c1.7 0 3.2 1 4 2.4.8-1.4 2.3-2.4 4-2.4 2.3 0 4.5 2 4.5 4.9 0 6.1-8.5 11.1-8.5 11.1z",
};

const [featured, ...rest] = aktif;
const featuredImg = gambarPertama(featured.gambar);
const gambarList = parseGambar(featured.gambar);
const imgKedua = gambarList[1] ?? null;
const imgKetiga = gambarList[2] ?? null;

// Helper: strip HTML to plain text and truncate
const stripHtml = (html: string | null, max = 220) => {
  if (!html) return "";
  const txt = html.replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim();
  return txt.length > max ? txt.slice(0, max).trimEnd() + "…" : txt;
};

const youtubeId = (url: string | null) => {
  if (!url) return null;
  const m = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|v\/))([\w-]{11})/);
  return m ? m[1] : null;
};
const yt = youtubeId(featured.linkyoutube);
---

<section id="tentang" class="section relative overflow-hidden">
  {/* Decorative background */}
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-prima-tint via-paper to-canvas"></div>
  <div class="absolute top-20 -right-32 w-96 h-96 rounded-full bg-prima-soft/60 blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-10 -left-32 w-96 h-96 rounded-full bg-teal/5 blur-3xl pointer-events-none"></div>

  <div class="wrap">
    {/* Section header — magazine style */}
    <div class="grid lg:grid-cols-[1fr_auto] gap-6 items-end mb-12">
      <div data-reveal>
        <div class="eyebrow mb-4">
          <span class="w-8 h-px bg-coral"></span>
          Tentang Kami
        </div>
        <h2 class="text-[clamp(32px,4.5vw,56px)] font-extrabold leading-[1.02] tracking-tight text-balance max-w-2xl">
          Mengenal lebih dekat
          <span class="block text-prima">RS Royal Prima Jambi</span>
        </h2>
      </div>
      <p data-reveal data-reveal-delay="100" class="text-ink-soft/75 text-[15px] leading-relaxed max-w-sm lg:text-right">
        Rumah sakit terpadu yang berkomitmen memberikan layanan kesehatan berkualitas, profesional, dan terjangkau bagi masyarakat Jambi.
      </p>
    </div>

    {/* Featured + sidebar grid */}
    <div class="grid lg:grid-cols-12 gap-6">
      {/* === FEATURED CARD === */}
      <article
        data-reveal
        class="lg:col-span-7 group relative overflow-hidden rounded-[28px] bg-ink shadow-[0_30px_80px_-30px_rgba(15,31,58,0.4)] hover:shadow-[0_40px_100px_-30px_rgba(15,31,58,0.5)] transition-all duration-500 min-h-[520px] lg:min-h-[640px] flex flex-col"
      >
        {/* Background image with overlay */}
        {featuredImg && (
          <div class="absolute inset-0">
            <img
              src={featuredImg}
              alt={featured.judul}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-[1500ms]"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/70 to-ink/20"></div>
            <div class="absolute inset-0 bg-gradient-to-r from-ink/60 via-transparent to-transparent"></div>
          </div>
        )}

        {/* Top chips */}
        <div class="relative z-10 p-6 lg:p-8 flex items-start justify-between gap-4">
          <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/15 backdrop-blur-md border border-white/25 text-white text-[10px] font-extrabold uppercase tracking-[0.2em]">
            <span class="w-1.5 h-1.5 rounded-full bg-coral"></span>
            Featured
          </span>
          {yt && (
            <button
              type="button"
              data-video-id={yt}
              data-video-title={featured.judul}
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-coral/95 hover:bg-coral-d text-white text-[10px] font-extrabold uppercase tracking-[0.18em] shadow-lg transition-colors cursor-pointer"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-3 h-3">
                <path d="M23 12s0-3.5-.4-5.2c-.2-.9-.9-1.6-1.8-1.8C19 4.6 12 4.6 12 4.6s-7 0-8.8.4c-.9.2-1.6.9-1.8 1.8C1 8.5 1 12 1 12s0 3.5.4 5.2c.2.9.9 1.6 1.8 1.8 1.8.4 8.8.4 8.8.4s7 0 8.8-.4c.9-.2 1.6-.9 1.8-1.8.4-1.7.4-5.2.4-5.2zM9.8 15.3V8.7l5.7 3.3-5.7 3.3z" />
              </svg>
              Video Profil
            </button>
          )}
        </div>

        {/* Big center play button — opens video popup */}
        {yt && (
          <button
            type="button"
            data-video-id={yt}
            data-video-title={featured.judul}
            aria-label={`Putar video profil ${featured.judul}`}
            class="group/play absolute z-10 left-1/2 top-[34%] -translate-x-1/2 -translate-y-1/2 cursor-pointer"
          >
            <span class="play-pulse flex w-16 h-16 lg:w-20 lg:h-20 rounded-full bg-coral/95 group-hover/play:scale-110 group-hover/play:bg-coral-d flex items-center justify-center text-white shadow-2xl transition-all duration-300">
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 lg:w-7 lg:h-7 ml-1">
                <path d="M8 5v14l11-7z" />
              </svg>
            </span>
          </button>
        )}

        {/* Second image — polaroid collage */}
        {imgKedua && (
          <figure class="absolute z-10 top-24 lg:top-28 right-4 lg:right-8 w-28 sm:w-36 lg:w-44 rotate-[4deg] group-hover:rotate-0 group-hover:scale-105 transition-transform duration-500 ease-out">
            <div class="p-1.5 pb-2 bg-white rounded-xl shadow-[0_20px_40px_-15px_rgba(0,0,0,0.55)]">
              <img
                src={imgKedua}
                alt={`${featured.judul} — galeri`}
                class="w-full aspect-[4/3] object-cover rounded-lg"
                loading="lazy"
              />
              <figcaption class="flex items-center justify-center gap-1 pt-1.5 text-[9px] font-extrabold uppercase tracking-[0.15em] text-ink/60">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-2.5 h-2.5">
                  <path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z" />
                  <circle cx="12" cy="13" r="4" />
                </svg>
                Galeri
              </figcaption>
            </div>
            {imgKetiga && (
              <img
                src={imgKetiga}
                alt={`${featured.judul} — galeri 2`}
                class="absolute -bottom-3 -left-5 w-16 sm:w-20 aspect-[4/3] object-cover rounded-lg border-4 border-white shadow-xl -rotate-[8deg] -z-10"
                loading="lazy"
              />
            )}
          </figure>
        )}

        {/* Bottom content */}
        <div class="relative z-10 mt-auto p-6 lg:p-10">
          <h3 class="text-white font-extrabold text-[clamp(28px,3.5vw,44px)] leading-[1.05] tracking-tight text-balance max-w-xl drop-shadow-lg">
            {featured.judul}
          </h3>
          <p class="mt-4 text-white/85 text-[15px] lg:text-base leading-relaxed max-w-lg">
            {stripHtml(featured.isi, 240)}
          </p>

          <div class="mt-7 flex flex-wrap items-center gap-3">
            {yt ? (
              <button
                type="button"
                data-video-id={yt}
                data-video-title={featured.judul}
                class="group/btn inline-flex items-center gap-3 pl-3 pr-5 py-3 rounded-full bg-coral hover:bg-coral-d text-white font-bold shadow-xl shadow-coral/30 hover:-translate-y-0.5 transition-all cursor-pointer"
              >
                <span class="w-9 h-9 rounded-full bg-white/20 flex items-center justify-center group-hover/btn:scale-110 transition-transform">
                  <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 ml-0.5">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </span>
                <span class="flex flex-col leading-none">
                  <span class="text-[10px] uppercase tracking-[0.16em] text-white/80 font-bold">Tonton</span>
                  <span class="text-sm">Video Profil</span>
                </span>
              </button>
            ) : (
              <span class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-white/10 border border-white/20 text-white/80 text-sm font-semibold backdrop-blur-md">
                Selengkapnya di bawah
              </span>
            )}

            <a
              href="/#poliklinik"
              class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-white/10 hover:bg-white/15 border border-white/20 hover:border-white/40 text-white font-semibold text-sm backdrop-blur-md transition-all hover:-translate-y-0.5"
            >
              Layanan Kami
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          </div>
        </div>
      </article>

      {/* === SIDEBAR CARDS === */}
      <div class="lg:col-span-5 flex flex-col gap-6">
        {rest.map((t, i) => {
          const img = gambarPertama(t.gambar);
          const vid = youtubeId(t.linkyoutube);
          return (
            <article
              data-reveal
              data-reveal-delay={150 + i * 100}
              class="group relative overflow-hidden rounded-3xl bg-white border border-line shadow-[0_18px_50px_-25px_rgba(15,31,58,0.2)] hover:shadow-[0_28px_70px_-30px_rgba(15,31,58,0.3)] transition-all duration-500 hover:-translate-y-1 flex-1 min-h-[240px] lg:min-h-[308px] grid grid-cols-[40%_1fr]"
            >
              {/* Image side */}
              <div class="relative overflow-hidden bg-canvas">
                {img ? (
                  <img
                    src={img}
                    alt={t.judul}
                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                    loading="lazy"
                  />
                ) : (
                  <div class="absolute inset-0 bg-gradient-to-br from-prima-soft to-coral-soft flex items-center justify-center">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-12 h-12 text-prima/40">
                      <path d="M4 16l4.58-4.58a2 2 0 012.83 0L16 16m-2-2l1.42-1.42a2 2 0 012.83 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                  </div>
                )}
                <div class="absolute inset-y-0 right-0 w-8 bg-gradient-to-l from-white/90 to-transparent pointer-events-none"></div>
              </div>

              {/* Content side */}
              <div class="p-5 lg:p-6 flex flex-col">
                <div class="eyebrow text-coral mb-2 text-[10px]">
                  Artikel {String(i + 2).padStart(2, "0")}
                </div>
                <h3 class="font-extrabold text-[16px] lg:text-[18px] leading-tight tracking-tight mb-2 line-clamp-2">
                  {t.judul}
                </h3>
                <p class="text-[13px] text-ink-soft/75 leading-relaxed line-clamp-3 flex-1">
                  {stripHtml(t.isi, 110)}
                </p>

                <div class="mt-4 flex items-center gap-3">
                  {vid ? (
                    <button
                      type="button"
                      data-video-id={vid}
                      data-video-title={t.judul}
                      class="inline-flex items-center gap-1.5 text-[13px] font-bold text-coral hover:gap-2.5 transition-all cursor-pointer"
                    >
                      <span class="w-6 h-6 rounded-full bg-coral-soft flex items-center justify-center">
                        <svg viewBox="0 0 24 24" fill="currentColor" class="w-2.5 h-2.5 ml-0.5">
                          <path d="M8 5v14l11-7z" />
                        </svg>
                      </span>
                      Video
                    </button>
                  ) : t.linkyoutube ? (
                    <a
                      href={t.linkyoutube}
                      target="_blank"
                      rel="noreferrer"
                      class="inline-flex items-center gap-1.5 text-[13px] font-bold text-coral hover:gap-2.5 transition-all"
                    >
                      <span class="w-6 h-6 rounded-full bg-coral-soft flex items-center justify-center">
                        <svg viewBox="0 0 24 24" fill="currentColor" class="w-2.5 h-2.5 ml-0.5">
                          <path d="M8 5v14l11-7z" />
                        </svg>
                      </span>
                      Video
                    </a>
                  ) : (
                    <span class="inline-flex items-center gap-1.5 text-[13px] font-bold text-prima">
                      <span class="w-1.5 h-1.5 rounded-full bg-prima"></span>
                      Profil
                    </span>
                  )}
                  <span class="flex-1 h-px bg-line"></span>
                  <a href={`/#poliklinik`} class="text-ink-soft/60 hover:text-coral transition-colors" aria-label={`Baca ${t.judul}`}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 group-hover:translate-x-1 transition-transform">
                      <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          );
        })}

        {/* Stats card at bottom */}
        <div
          data-reveal
          data-reveal-delay={150 + rest.length * 100}
          class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-prima-d via-prima to-prima-l p-6 lg:p-7 text-white shadow-[0_20px_60px_-25px_rgba(7,79,135,0.5)]"
        >
          <div class="absolute -top-8 -right-8 w-32 h-32 rounded-full bg-white/10 blur-2xl pointer-events-none"></div>
          <div class="absolute -bottom-6 -left-6 w-24 h-24 rounded-full bg-coral/20 blur-2xl pointer-events-none"></div>

          <div class="relative">
            <div class="eyebrow text-white/70 mb-3 text-[10px]">Komitmen Kami</div>
            <p class="text-white font-extrabold text-lg leading-snug mb-4">
              "Memberikan layanan kesehatan terbaik dengan sepenuh hati"
            </p>
            <div class={`grid gap-3 pt-4 border-t border-white/20 ${komitmenStats.length === 4 ? "grid-cols-2" : "grid-cols-3"}`}>
              {komitmenStats.map((s) => (
                <div>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-white/50 mb-1.5" aria-hidden="true">
                    <path d={STAT_ICON_PATHS[s.ikon ?? ""] ?? "M12 5v14M5 12h14"}></path>
                  </svg>
                  <div class="font-extrabold text-2xl leading-none">{s.nilai}</div>
                  <div class="text-[10px] uppercase tracking-wider text-white/70 font-semibold mt-1">{s.label}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* === VIDEO POPUP MODAL === */}
  <div
    id="videoModal"
    class="fixed inset-0 z-[100] hidden items-center justify-center p-4 sm:p-6"
    role="dialog"
    aria-modal="true"
    aria-labelledby="videoModalTitle"
  >
    <div class="video-modal-backdrop absolute inset-0 bg-ink/85 backdrop-blur-sm"></div>
    <div class="video-modal-panel relative w-full max-w-4xl">
      <div class="flex items-center justify-between gap-4 mb-4">
        <div class="min-w-0">
          <div class="flex items-center gap-2 text-[10px] font-extrabold uppercase tracking-[0.2em] text-coral mb-1">
            <span class="w-6 h-px bg-coral"></span>
            Video Profil
          </div>
          <h3 id="videoModalTitle" class="text-white font-extrabold text-base sm:text-lg lg:text-xl truncate drop-shadow">
            Video Profil
          </h3>
        </div>
        <button
          type="button"
          data-close-modal
          aria-label="Tutup video"
          class="shrink-0 w-10 h-10 rounded-full bg-white/10 hover:bg-coral border border-white/20 hover:border-coral flex items-center justify-center text-white transition-colors cursor-pointer"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="w-5 h-5">
            <path d="M18 6L6 18M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="aspect-video rounded-2xl overflow-hidden bg-black ring-1 ring-white/20 shadow-2xl">
        <iframe
          id="videoFrame"
          class="w-full h-full"
          title="Video profil RS Royal Prima Jambi"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>
</section>

<script>
  const modal = document.getElementById("videoModal");
  const frame = document.getElementById("videoFrame") as HTMLIFrameElement | null;
  const titleEl = document.getElementById("videoModalTitle");
  const closeBtn = modal?.querySelector<HTMLButtonElement>("[data-close-modal]");
  let lastFocus: HTMLElement | null = null;

  function openVideo(id: string | null, title: string | null) {
    if (!modal || !frame || !id) return;
    if (titleEl) titleEl.textContent = title || "Video Profil";
    frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    requestAnimationFrame(() => modal.classList.add("is-open"));
    document.body.style.overflow = "hidden";
    closeBtn?.focus();
  }

  function closeVideo() {
    if (!modal || !frame) return;
    frame.src = "about:blank";
    modal.classList.remove("is-open");
    window.setTimeout(() => {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
    }, 280);
    document.body.style.overflow = "";
    lastFocus?.focus();
  }

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const trigger = target.closest("[data-video-id]");
    if (trigger) {
      e.preventDefault();
      lastFocus = trigger as HTMLElement;
      openVideo(trigger.getAttribute("data-video-id"), trigger.getAttribute("data-video-title"));
      return;
    }
    if (target.closest("[data-close-modal]") || target.classList.contains("video-modal-backdrop")) {
      closeVideo();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modal && !modal.classList.contains("hidden")) closeVideo();
  });
</script>

<style>
  .video-modal-backdrop {
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .video-modal-panel {
    opacity: 0;
    transform: translateY(24px) scale(0.96);
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  #videoModal.is-open .video-modal-backdrop {
    opacity: 1;
  }
  #videoModal.is-open .video-modal-panel {
    opacity: 1;
    transform: none;
  }

  @keyframes pulseRing {
    0% { box-shadow: 0 0 0 0 rgba(232, 65, 44, 0.5); }
    70% { box-shadow: 0 0 0 24px rgba(232, 65, 44, 0); }
    100% { box-shadow: 0 0 0 0 rgba(232, 65, 44, 0); }
  }
  .play-pulse {
    animation: pulseRing 2.4s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .play-pulse { animation: none; }
    .video-modal-backdrop,
    .video-modal-panel { transition: none; }
  }
</style>
